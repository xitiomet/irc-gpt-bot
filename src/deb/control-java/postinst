#!/bin/bash
echo irc-gpt-bot Post-Install Script Running!
autostart="yes"
if [[ -f /etc/irc-gpt-bot/autostart ]]; then
    autostart="$(tr -d '[:space:]' < /etc/irc-gpt-bot/autostart)"
fi
update-rc.d irc-gpt-bot defaults
if [[ "$autostart" == "no" ]]; then
    update-rc.d irc-gpt-bot disable
    echo "Auto-start disabled. Start manually with: /etc/init.d/irc-gpt-bot start"
    echo "To enable at boot: update-rc.d irc-gpt-bot enable"
else
    update-rc.d irc-gpt-bot enable
    /etc/init.d/irc-gpt-bot start
fi
echo Bot Server available at http://127.0.0.1:6553/
echo edit /etc/irc-gpt-bot/irc-gpt-bot.json to change password!
